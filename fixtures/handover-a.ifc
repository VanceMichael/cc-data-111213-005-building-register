ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('两次移交的合成资料'),'2;1');
FILE_NAME('handover-a.ifc','2026-11-01T00:00:00',('资料组'),('园区'),'','','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
/* Units.  The project's pressure unit is the pascal; the bar used by a
   property is a conversion-based unit, and the millimetre used by an
   installation length is another one.  The volumetric flow unit is derived
   from metre and second. */
#1=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);
#2=IFCSIUNIT(*,.MASSUNIT.,.KILO.,.GRAM.);
#3=IFCSIUNIT(*,.TIMEUNIT.,$,.SECOND.);
#4=IFCSIUNIT(*,.PRESSUREUNIT.,$,.PASCAL.);
#5=IFCMEASUREWITHUNIT(IFCPRESSUREMEASURE(100000.),#4);
#6=IFCCONVERSIONBASEDUNIT(#7,.PRESSUREUNIT.,'bar',#5);
#7=IFCDIMENSIONALEXPONENTS(1,-1,2,0,0,0,0);
#8=IFCSIUNIT(*,.PLANEANGLEUNIT.,$,.RADIAN.);
#10=IFCDERIVEDUNITELEMENT(#1,3);
#11=IFCDERIVEDUNITELEMENT(#3,-1);
#12=IFCDERIVEDUNIT((#10,#11),.VOLUMETRICFLOWRATEUNIT.,$);
#13=IFCSIUNIT(*,.THERMODYNAMICTEMPERATUREUNIT.,$,.KELVIN.);
#14=IFCDIMENSIONALEXPONENTS(1,0,0,0,0,0,0);
#15=IFCMEASUREWITHUNIT(IFCLENGTHMEASURE(0.001),#1);
#16=IFCCONVERSIONBASEDUNIT(#14,.LENGTHUNIT.,'mm',#15);
#9=IFCUNITASSIGNMENT((#1,#2,#3,#4,#8,#12,#13));
#100=IFCPROJECT('1AAAAAAAAAAAAAAAAAAAAA',$,'园区',$,$,$,$,$,#9);
#101=IFCBUILDING('1BBBBBBBBBBBBBBBBBBBBB',$,'主楼',$,$,$,$,$,.ELEMENT.,$,$,$);
#102=IFCBUILDINGSTOREY('1CCCCCCCCCCCCCCCCCCCCC',$,'一层',$,$,$,$,$,.ELEMENT.,0.);
#103=IFCBUILDINGSTOREY('1DDDDDDDDDDDDDDDDDDDDD',$,'二层',$,$,$,$,$,.ELEMENT.,4.5);
#110=IFCRELAGGREGATES('1EEEEEEEEEEEEEEEEEEEEE',$,$,$,#101,(#102,#103));
#111=IFCRELAGGREGATES('1FFFFFFFFFFFFFFFFFFFFF',$,$,$,#100,(#101));

/* Type objects.  #200 and #201 each carry a property set; #202 belongs to a
   part that is only reachable through an assembly. */
#200=IFCPUMPTYPE('2AAAAAAAAAAAAAAAAAAAAA',$,'立式泵',$,$,(#301),$,$,$,.CIRCULATOR.);
#201=IFCFLOWTERMINALTYPE('2BBBBBBBBBBBBBBBBBBBBB',$,'风机盘管',$,$,(#302),$,$,$,.USERDEFINED.);
#202=IFCDUCTFITTINGTYPE('2CCCCCCCCCCCCCCCCCCCCC',$,'过渡件（待拆）',$,$,$,$,$,$,.JUNCTION.);

/* Property set attached to the pump type.  Its name matches the instance
   set below, so a name-based merge would collapse the two 型号 values. */
#301=IFCPROPERTYSET('3AAAAAAAAAAAAAAAAAAAAA',$,'设备参数',$,(#400,#401));
#400=IFCPROPERTYSINGLEVALUE('型号',$,IFCLABEL('P-200'),$);
#401=IFCPROPERTYSINGLEVALUE('额定流量',$,IFCVOLUMETRICFLOWRATEMEASURE(0.036),$);

/* Fan-coil type set with nested values: an enumerated value with its
   enumeration reference, and a list of measures with declared types. */
#302=IFCPROPERTYSET('3BBBBBBBBBBBBBBBBBBBBB',$,'风机参数',$,(#410,#411,#412));
#410=IFCPROPERTYSINGLEVALUE('型号',$,IFCLABEL('FCU-100'),$);
#411=IFCPROPERTYENUMERATEDVALUE('安装方式',$,(IFCLABEL('吊顶'),IFCLABEL('壁挂')),#420);
#412=IFCPROPERTYLISTVALUE('工作点',$,(IFCTHERMODYNAMICTEMPERATUREMEASURE(12.),IFCTHERMODYNAMICTEMPERATUREMEASURE(7.)),$);
#420=IFCPROPERTYENUMERATION('安装方式',(IFCLABEL('吊顶'),IFCLABEL('壁挂')),$);

/* #500 and #501 share a name but have different GlobalIds; #501 has no
   spatial containment at all. */
#500=IFCPUMP('4AAAAAAAAAAAAAAAAAAAAA',$,'循环泵',$,$,$,$,'P-1',.CIRCULATOR.);
#510=IFCRELDEFINESBYTYPE('4BBBBBBBBBBBBBBBBBBBBB',$,$,$,(#500),#200);
#511=IFCRELCONTAINEDINSPATIALSTRUCTURE('4CCCCCCCCCCCCCCCCCCCCC',$,$,$,(#500),#102);
#512=IFCRELDEFINESBYPROPERTIES('4DDDDDDDDDDDDDDDDDDDDD',$,$,$,(#500),#320);
#320=IFCPROPERTYSET('4EEEEEEEEEEEEEEEEEEEEE',$,'设备参数',$,(#421,#422,#423));
#421=IFCPROPERTYSINGLEVALUE('型号',$,IFCLABEL('P-200-B'),$);
#422=IFCPROPERTYSINGLEVALUE('安装长度',$,IFCLENGTHMEASURE(1200.),#16);
#423=IFCPROPERTYSINGLEVALUE('设计压力',$,IFCPRESSUREMEASURE(0.6),#6);

#501=IFCPUMP('4FFFFFFFFFFFFFFFFFFFFF',$,'循环泵',$,$,$,$,'P-2',.CIRCULATOR.);
#513=IFCRELDEFINESBYTYPE('5AAAAAAAAAAAAAAAAAAAAA',$,$,$,(#501),#200);
#514=IFCRELDEFINESBYPROPERTIES('5BBBBBBBBBBBBBBBBBBBBB',$,$,$,(#501),#321);
#321=IFCPROPERTYSET('5CCCCCCCCCCCCCCCCCCCCC',$,'设备参数',$,(#424));
#424=IFCPROPERTYSINGLEVALUE('型号',$,IFCLABEL('P-200'),$);

/* #502 consists of #5021; only the assembly is contained directly. */
#502=IFCFLOWTERMINAL('5DDDDDDDDDDDDDDDDDDDDD',$,'风机盘管',$,$,$,$,'FCU-1',.USERDEFINED.);
#515=IFCRELDEFINESBYTYPE('5EEEEEEEEEEEEEEEEEEEEE',$,$,$,(#502),#201);
#516=IFCRELCONTAINEDINSPATIALSTRUCTURE('5FFFFFFFFFFFFFFFFFFFFF',$,$,$,(#502),#103);
#517=IFCRELDEFINESBYPROPERTIES('6AAAAAAAAAAAAAAAAAAAAA',$,$,$,(#502),#322);
#322=IFCPROPERTYSET('6BBBBBBBBBBBBBBBBBBBBB',$,'风机参数',$,(#425));
#425=IFCPROPERTYSINGLEVALUE('型号',$,IFCLABEL('FCU-100'),$);

#5021=IFCDUCTFITTING('6CCCCCCCCCCCCCCCCCCCCC',$,'过渡件',$,$,$,$,'F-1',.JUNCTION.);
#518=IFCRELNESTS('6DDDDDDDDDDDDDDDDDDDDD',$,'组件',$,#502,(#5021));
#519=IFCRELDEFINESBYTYPE('6EEEEEEEEEEEEEEEEEEEEE',$,$,$,(#5021),#202);

/* #503 has two contradictory type relations. */
#503=IFCPUMP('6FFFFFFFFFFFFFFFFFFFFF',$,'备用泵',$,$,$,$,'P-3',.CIRCULATOR.);
#520=IFCRELDEFINESBYTYPE('7AAAAAAAAAAAAAAAAAAAAA',$,$,$,(#503),#200);
#521=IFCRELDEFINESBYTYPE('7BBBBBBBBBBBBBBBBBBBBB',$,$,$,(#503),#203);
#203=IFCPUMPTYPE('7CCCCCCCCCCCCCCCCCCCCC',$,'卧式泵',$,$,$,$,$,$,.CIRCULATOR.);
#522=IFCRELCONTAINEDINSPATIALSTRUCTURE('7DDDDDDDDDDDDDDDDDDDDD',$,$,$,(#503),#102);

/* Explicit override relation: #524 overrides only property #426 of set #523
   for device #502.  The other property in that set is not overridden. */
#523=IFCPROPERTYSET('7EEEEEEEEEEEEEEEEEEEEE',$,'运行参数',$,(#426,#427));
#426=IFCPROPERTYSINGLEVALUE('运行压力',$,IFCPRESSUREMEASURE(4.),#6);
#427=IFCPROPERTYSINGLEVALUE('设备编号',$,IFCIDENTIFIER('FCU-1'),$);
#524=IFCRELOVERRIDESPROPERTIES('7FFFFFFFFFFFFFFFFFFFFF',$,$,$,(#502),#523,(#426));

/* #504 has a property relation to a missing set and a missing property step:
   both are reported, and the device stays in the ledger as partial. */
#504=IFCFLOWTERMINAL('8AAAAAAAAAAAAAAAAAAAAA',$,'排风机',$,$,$,$,'F-2',.USERDEFINED.);
#525=IFCRELDEFINESBYPROPERTIES('8BBBBBBBBBBBBBBBBBBBBB',$,$,$,(#504),#999);
#526=IFCRELCONTAINEDINSPATIALSTRUCTURE('8CCCCCCCCCCCCCCCCCCCCC',$,$,$,(#504),#103);
#527=IFCRELDEFINESBYTYPE('8DDDDDDDDDDDDDDDDDDDDD',$,$,$,(#504),#201);
#528=IFCRELDEFINESBYPROPERTIES('8EEEEEEEEEEEEEEEEEEEEE',$,$,$,(#504),#323);
#323=IFCPROPERTYSET('8FFFFFFFFFFFFFFFFFFFFF',$,'排风参数',$,(#428,#429,#998));
#428=IFCPROPERTYSINGLEVALUE('风量',$,IFCVOLUMETRICFLOWRATEMEASURE(0.3),$);
#429=IFCPROPERTYSINGLEVALUE('静压',$,IFCPRESSUREMEASURE(120.),#6);

/* A property set that is never referenced by any relation. */
#330=IFCPROPERTYSET('9AAAAAAAAAAAAAAAAAAAAA',$,'孤立属性',$,(#440));
#440=IFCPROPERTYSINGLEVALUE('备注',$,IFCLABEL('未挂接'),$);
ENDSEC;
END-ISO-10303-21;
