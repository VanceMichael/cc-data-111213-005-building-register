ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('第三次移交：仅用于说明不确定性的合成资料'),'2;1');
FILE_NAME('handover-c.ifc','2026-11-20T00:00:00',('资料组'),('园区'),'','','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);
#2=IFCSIUNIT(*,.MASSUNIT.,.KILO.,.GRAM.);
#3=IFCSIUNIT(*,.TIMEUNIT.,$,.SECOND.);
#4=IFCSIUNIT(*,.PRESSUREUNIT.,$,.PASCAL.);
#5=IFCMEASUREWITHUNIT(IFCPRESSUREMEASURE(100000.),#4);
#6=IFCCONVERSIONBASEDUNIT(#7,.PRESSUREUNIT.,'bar',#5);
#7=IFCDIMENSIONALEXPONENTS(1,0,0,0,0,0,0);
#8=IFCSIUNIT(*,.PLANEANGLEUNIT.,$,.RADIAN.);
#10=IFCDERIVEDUNITELEMENT(#1,3);
#11=IFCDERIVEDUNITELEMENT(#3,-1);
#12=IFCDERIVEDUNIT((#10,#11),.VOLUMETRICFLOWRATEUNIT.,$);
#13=IFCSIUNIT(*,.THERMODYNAMICTEMPERATUREUNIT.,$,.KELVIN.);
#9=IFCUNITASSIGNMENT((#1,#2,#3,#6,#8,#12,#13));
#100=IFCPROJECT('1AAAAAAAAAAAAAAAAAAAAA',$,'园区',$,$,$,$,$,#9);
#101=IFCBUILDING('1BBBBBBBBBBBBBBBBBBBBB',$,'主楼',$,$,$,$,$,.ELEMENT.,$,$,$);
#102=IFCBUILDINGSTOREY('1CCCCCCCCCCCCCCCCCCCCC',$,'一层',$,$,$,$,$,.ELEMENT.,0.);
#103=IFCBUILDINGSTOREY('1DDDDDDDDDDDDDDDDDDDDD',$,'二层',$,$,$,$,$,.ELEMENT.,4.5);
#110=IFCRELAGGREGATES('1EEEEEEEEEEEEEEEEEEEEE',$,$,$,#101,(#102,#103));
#111=IFCRELAGGREGATES('1FFFFFFFFFFFFFFFFFFFFF',$,$,$,#100,(#101));

#200=IFCPUMPTYPE('2AAAAAAAAAAAAAAAAAAAAA',$,'立式泵',$,$,(#301),$,$,$,.CIRCULATOR.);
#301=IFCPROPERTYSET('3AAAAAAAAAAAAAAAAAAAAA',$,'设备参数',$,(#400,#401));
#400=IFCPROPERTYSINGLEVALUE('型号',$,IFCLABEL('P-200'),$);
#401=IFCPROPERTYSINGLEVALUE('额定流量',$,IFCVOLUMETRICFLOWRATEMEASURE(42.),$);

/* #500 remains, #501 is deliberately left out to demonstrate that a
   dangling relation to it blocks the removal claim. */
#500=IFCPUMP('4AAAAAAAAAAAAAAAAAAAAA',$,'循环泵',$,$,$,$,'P-1',.CIRCULATOR.);
#510=IFCRELDEFINESBYTYPE('4BBBBBBBBBBBBBBBBBBBBB',$,$,$,(#500),#200);
#511=IFCRELCONTAINEDINSPATIALSTRUCTURE('4CCCCCCCCCCCCCCCCCCCCC',$,$,$,(#500),#103);
#512=IFCRELDEFINESBYPROPERTIES('4DDDDDDDDDDDDDDDDDDDDD',$,$,$,(#500),#320);
#320=IFCPROPERTYSET('4EEEEEEEEEEEEEEEEEEEEE',$,'设备参数',$,(#421,#422,#423));
#421=IFCPROPERTYSINGLEVALUE('型号',$,IFCLABEL('P-200-C'),$);
#422=IFCPROPERTYSINGLEVALUE('安装长度',$,IFCLENGTHMEASURE(1.25),#1);
#423=IFCPROPERTYSINGLEVALUE('设计压力',$,IFCPRESSUREMEASURE(0.6),#6);

/* A property relation that still points at the absent #501. */
#513=IFCRELDEFINESBYTYPE('5AAAAAAAAAAAAAAAAAAAAA',$,$,$,(#501),#200);

/* #503 remains with the repaired single type relation. */
#503=IFCPUMP('6FFFFFFFFFFFFFFFFFFFFF',$,'备用泵',$,$,$,$,'P-3',.CIRCULATOR.);
#520=IFCRELDEFINESBYTYPE('7AAAAAAAAAAAAAAAAAAAAA',$,$,$,(#503),#203);
#203=IFCPUMPTYPE('7CCCCCCCCCCCCCCCCCCCCC',$,'卧式泵',$,$,$,$,$,$,.CIRCULATOR.);
#522=IFCRELCONTAINEDINSPATIALSTRUCTURE('7DDDDDDDDDDDDDDDDDDDDD',$,$,$,(#503),#102);

#505=IFCPUMP('9BBBBBBBBBBBBBBBBBBBBB',$,'补水泵',$,$,$,$,'P-4',.CIRCULATOR.);
#530=IFCRELDEFINESBYTYPE('9CCCCCCCCCCCCCCCCCCCCC',$,$,$,(#505),#200);
#531=IFCRELCONTAINEDINSPATIALSTRUCTURE('9DDDDDDDDDDDDDDDDDDDDD',$,$,$,(#505),#102);
#532=IFCRELDEFINESBYPROPERTIES('9EEEEEEEEEEEEEEEEEEEEE',$,$,$,(#505),#324);
#324=IFCPROPERTYSET('9FFFFFFFFFFFFFFFFFFFFF',$,'设备参数',$,(#430));
#430=IFCPROPERTYSINGLEVALUE('型号',$,IFCLABEL('P-200'),$);
ENDSEC;
END-ISO-10303-21;
